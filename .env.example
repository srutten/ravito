# ---------------------------------------------------------------------------
# Fichier d'exemple. Aucune valeur reelle ne doit figurer ici.
# Copier en `.env.local` puis renseigner les valeurs locales.
# `.env.local` et `.env` sont ignores par git.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Environnement de deploiement logique : local | staging | production
APP_ENV=local
# Version affichee par la sonde de sante. Injectee par la CI en staging et production.
APP_VERSION=0.1.0
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Base de donnees --------------------------------------------------------
# PostgreSQL 17 avec extension PostGIS.
# En local : `npm run db:up` demarre le conteneur decrit dans docker-compose.yml.
DATABASE_URL=postgresql://fire_support:REMPLACER@localhost:5432/fire_support
# Taille maximale du pool de connexions.
DATABASE_POOL_MAX=10
# Delai maximal d'une requete, en millisecondes.
DATABASE_STATEMENT_TIMEOUT_MS=10000
# `require` en staging et production, `disable` en local.
DATABASE_SSL=disable

# Compte dedie aux operations de schema, utilise par db:migrate, db:status et db:reset.
# Hors poste local, il doit etre DISTINCT du compte de DATABASE_URL : le compte applicatif
# n'a ni droit de schema ni privilege de superutilisateur.
# Absente, les scripts de migration retombent sur DATABASE_URL avec un avertissement.
DATABASE_MIGRATION_URL=
# Nom du role applicatif. Il est cree sans droit de connexion par une migration, puis active
# par `npm run db:bootstrap-roles`. Une migration ne contient jamais de mot de passe.
DATABASE_APP_ROLE=
# Mot de passe attribue au role applicatif par `npm run db:bootstrap-roles`.
# 16 caracteres au minimum, produit par le gestionnaire de secrets, distinct par environnement.
DATABASE_APP_PASSWORD=

# --- Authentification (Lot 1) ----------------------------------------------
# Secret de signature de session. Genere par le gestionnaire de secrets,
# distinct par environnement, jamais partage entre environnements.
AUTH_SECRET=

# --- Stockage objet (Lot 2) -------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Fournisseurs de notification (Lot 5) -----------------------------------
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=

# --- Cartographie (Lot 7) ---------------------------------------------------
MAP_STYLE_URL=

# --- Observabilite ----------------------------------------------------------
OBSERVABILITY_DSN=

# --- Feature flags ----------------------------------------------------------
# Source de lecture des flags : `env` uniquement pour le Lot 0.
FEATURE_FLAGS_SOURCE=env

# Flags produit (docs/feature-flags.md). Valeur par defaut : desactive.
ENABLE_PUBLIC_REGISTRATION=false
ENABLE_SMS=false
ENABLE_EMAIL=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_REALTIME=false
ENABLE_OFFLINE_QUEUE=false
ENABLE_RESOURCE_DOCUMENTS=false
ENABLE_PRECISE_LOCATION=false
ENABLE_MATCHING_SCORE=false
ENABLE_OBSERVER_ROLE=false

# Interrupteurs de securite. Modifiables uniquement par un admin plateforme,
# tout changement est audite.
PLATFORM_READ_ONLY=false
DISABLE_NEW_REQUESTS=false
DISABLE_NEW_MISSIONS=false
HIDE_PRECISE_LOCATIONS=false
DISABLE_FILE_UPLOADS=false
FORCE_SESSION_REVOCATION=false

# --- Tests end-to-end -------------------------------------------------------
E2E_BASE_URL=http://localhost:3000
