{
  "name": "fire-support-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Appui Feux - mobilisation logistique securisee de moyens civils verifies en soutien aux operations incendie",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "stack:up": "docker compose up --build --watch",
    "stack:start": "docker compose up -d --build",
    "stack:stop": "docker compose stop",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v --remove-orphans && docker compose up -d --build",
    "stack:ps": "docker compose ps",
    "stack:logs": "docker compose logs -f",
    "stack:psql": "docker compose exec db psql -U fire_support -d fire_support",
    "stack:shell": "docker compose exec app sh",
    "image:build": "docker build -f docker/app.Dockerfile --target runner -t appui-feux:local .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db/status.mjs",
    "db:reset": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db/reset.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db/seed.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "pino-pretty": "^13.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
